class Checks:
    """Read-only diagnostics. Warnings are not passed security invariants."""
    def __init__(self):
        self.failed = 0
        self.pending = 0

    def ok(self, message):
        print('OK: ' + message)

    def fail(self, message):
        self.failed += 1
        print('FAIL: ' + message, file=sys.stderr)

    def warn(self, message):
        print('WARN: ' + message, file=sys.stderr)

    def wait(self, message):
        self.pending += 1
        print('PENDING: ' + message, file=sys.stderr)


def check_dir(checks, path, expected_mode):
    """Check exact root ownership/mode, not following directory symlinks."""
    try:
        st = path.lstat()
    except OSError as exc:
        checks.fail('{}: {}'.format(path, exc))
        return False
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_gid != 0:
        checks.fail('{}: must be a non-symlink root:root directory'.format(path))
        return False
    mode = stat.S_IMODE(st.st_mode)
    if mode != expected_mode:
        checks.fail('{}: mode {:04o}, required {:04o}'.format(path, mode, expected_mode))
        return False
    checks.ok('{} root:root {:04o}'.format(path, mode))
    return True


def check_file(checks, path, uid, gid, expected_mode):
    """Check file ownership, type, hardlinks and mode without following symlinks."""
    try:
        st = path.lstat()
    except OSError as exc:
        checks.fail('{}: {}'.format(path, exc))
        return False
    if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_gid != gid:
        checks.fail('{}: unexpected type or UID/GID (symlinks rejected)'.format(path))
        return False
    mode = stat.S_IMODE(st.st_mode)
    if mode != expected_mode or st.st_nlink != 1:
        checks.fail('{}: unsafe mode {:04o} or link count {}'.format(path, mode, st.st_nlink))
        return False
    checks.ok('{} owner {}/{} {:04o}'.format(path, uid, gid, mode))
    return True


USERNAME_RE = re.compile(r'^[a-z_][a-z0-9_-]{0,31}$')


def managed_account(checks, name, role):
    """Read-only NSS validation, NEVER proof of account ownership for deletion.

    Mutating userdel/chpasswd/revoke code must ALSO validate root-owned AAP2
    metadata containing original name/UID/GID/groups/home before EVERY change.
    Being UID>=1001 or a member of an AAP2 group is never sufficient.
    """
    if not USERNAME_RE.fullmatch(name):
        checks.fail('invalid account name: {!r}'.format(name))
        return None
    try:
        user = pwd.getpwnam(name)
        role_grp = grp.getgrnam(role)
    except KeyError:
        checks.fail('{} or {} does not exist in NSS'.format(name, role))
        return None
    if user.pw_uid < MIN_UID:
        checks.fail('{} has UID {}; must be >= {}'.format(name, user.pw_uid, MIN_UID))
        return None
    if user.pw_shell not in SHELLS:
        checks.fail('{}: unsafe login shell {}'.format(name, user.pw_shell))
        return None
    memberships = os.getgrouplist(name, user.pw_gid)
    if role_grp.gr_gid not in memberships:
        checks.fail('{}: not a member of {}'.format(name, role))
        return None
    opposite = GROUP_PROXY if role == GROUP_ENROLL else GROUP_ENROLL
    try:
        if grp.getgrnam(opposite).gr_gid in memberships:
            checks.fail('{}: member of both AAP2 access groups'.format(name))
            return None
    except KeyError:
        pass
    checks.ok('{}: UID={} role={} nologin'.format(name, user.pw_uid, role))
    return user


def command_output(checks, args):
    """No shell, stdin, environment inheritance, network or config changes."""
    try:
        result = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True, timeout=12, check=False,
                                env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'})
    except (OSError, subprocess.TimeoutExpired) as exc:
        checks.fail('cannot run {}: {}'.format(args[0], exc))
        return None
    if result.returncode != 0:
        checks.fail('{} failed (exit {}): {}'.format(' '.join(args[:2]), result.returncode,
                                                 result.stderr.strip()[:240]))
        return None
    return result.stdout


def sshd_binary(checks):
    sshd = shutil.which('sshd', path='/usr/sbin:/usr/bin:/sbin:/bin')
    if sshd is None:
        checks.fail('sshd not installed/found')
    return sshd


def read_effective_config(checks, sshd, user, addr, client_host, server_addr, server_port):
    # sshd -C host= means remote client hostname, NOT the server hostname.
    # Reject context-attribute injection through comma-delimited input.
    if not USERNAME_RE.fullmatch(user):
        checks.fail('invalid username in sshd -C context')
        return None
    try:
        ipaddress.ip_address(addr)
        ipaddress.ip_address(server_addr)
    except ValueError:
        checks.fail('client/server addresses must be literal IPv4 or IPv6')
        return None
    if not re.fullmatch(r'[A-Za-z0-9.-]{1,253}', client_host):
        checks.fail('invalid client hostname in sshd -C context')
        return None
    try:
        number = int(server_port)
        if not 1 <= number <= 65535:
            raise ValueError
    except ValueError:
        checks.fail('invalid sshd local TCP port')
        return None
    context = 'user={},addr={},host={},laddr={},lport={}'.format(
        user, addr, client_host, server_addr, server_port)
    result = command_output(checks, [sshd, '-T', '-C', context])
    if result is None:
        return None
    config = {}
    for line in result.splitlines():
        if ' ' in line:
            key, value = line.split(' ', 1)
            config[key.strip().lower()] = value.strip()
    return config


def check_policy(checks, actual, role):
    # AAP2 cannot reliably infer whether arbitrary Allow*/Deny* glob
    # expressions and client DNS conditions will admit this account.
    # Refuse enrollment until the admin resolves global allow/deny policy.
    for key in ('allowusers', 'allowgroups', 'denyusers', 'denygroups'):
        if actual.get(key):
            checks.fail('{}: effective {} configured; manual review required (fail closed)'
                        .format(role, key))
    for key, expected in POLICY[role].items():
        found = actual.get(key, '<missing>')
        if found != expected:
            checks.fail('{}: {} expected {!r}, got {!r}'.format(role, key, expected, found))
    if all(actual.get(k) == v for k, v in POLICY[role].items()):
        checks.ok('{}: expected effective sshd Match policy'.format(role))


def validate_real_user_files(checks, name, role, user):
    if role == GROUP_ENROLL:
        home = ENROLL / name
        if not check_dir(checks, home, 0o755):
            return
        check_dir(checks, home / 'inbox', 0o755)
        check_file(checks, home / 'config.json', 0, 0, 0o644)
        check_file(checks, home / 'status.json', 0, 0, 0o644)
        check_file(checks, home / 'inbox' / 'public_key', user.pw_uid, user.pw_gid, 0o600)
    else:
        check_file(checks, AUTHORIZED / name, 0, 0, 0o644)


def doctor(args):
    checks = Checks()
    if os.geteuid() != 0:
        checks.fail('doctor requires root to validate sshd host keys and protected paths (NO changes made)')
        return 1
    if sys.version_info < (3, 9):
        checks.fail('Python >= 3.9 is required')
        return 1

    print('AAP2 doctor: READ-ONLY; checks config on disk, NEVER reloads active sshd')
    for name in (GROUP_ENROLL, GROUP_PROXY):
        try:
            grp.getgrnam(name)
            checks.ok('{} group exists'.format(name))
        except KeyError:
            checks.fail('required group {} missing; prepare manually before enrollment'.format(name))
    for path, mode in ((BASE, 0o755), (STATE, 0o700), (ENROLL, 0o755),
                       (AUTHORIZED, 0o755)):
        check_dir(checks, path, mode)

    sshd = sshd_binary(checks)
    if sshd is not None:
        if command_output(checks, [sshd, '-t']) is not None:
            checks.ok('sshd -t: on-disk syntax valid')

    if args.enroll_user or args.proxy_user:
        if not (args.enroll_user and args.proxy_user):
            checks.fail('give BOTH --enroll-user and --proxy-user for real Match checks')
        else:
            for role, username in ((GROUP_ENROLL, args.enroll_user), (GROUP_PROXY, args.proxy_user)):
                acct = managed_account(checks, username, role)
                if acct is not None:
                    validate_real_user_files(checks, username, role, acct)
                    if sshd is not None:
                        cfg = read_effective_config(checks, sshd, username, args.client_addr,
                                                    args.client_host, args.server_addr,
                                                    args.server_port)
                        if cfg is not None:
                            check_policy(checks, cfg, role)
    else:
        checks.wait('no real AAP2 users supplied; Match Group policy NOT verified. '
                    'This is preflight, NOT permission to activate PINs.')

    if shutil.which('fail2ban-client', path='/usr/sbin:/usr/bin:/sbin:/bin') is None:
        checks.warn('fail2ban not found: short-lived PIN susceptible to online guessing')

    # Real systemd timer, not a decorative expiry field.
    if timer_active():
        checks.ok('aap2-cleanup.timer is active (TTL enforced by periodic sweep)')
    else:
        checks.wait('aap2-cleanup.timer inactive/missing; PIN enrollment forbidden')

    print('Doctor summary: {} failures, {} outstanding enrollment gates'.format(
        checks.failed, checks.pending))
    return 1 if checks.failed else (2 if checks.pending else 0)


def print_config(_args):
    path = Path(__file__).resolve().parent / 'sshd-aap2-match.conf'
    if not path.is_file():
        print('Missing Match template: {}'.format(path), file=sys.stderr)
        return 1
    print('# MANUAL TEMPLATE ONLY: do NOT paste into sshd_config without review.')
    print('# Check existing Include/Match/AllowGroups, then sshd -t, sshd -T -C.')
    print(path.read_text(encoding='utf-8'), end='')
    return 0



# S1-B lifecycle. Only operations on verified, registered AAP2 accounts are
# permitted. The state root and chroots are never writable by those accounts.
ID_RE = re.compile(r'(?:[0-9a-f]{12}|[0-9]{6})')
PORT_LOW, PORT_HIGH = 11010, 11509
PIN_TTL = 600
MANUAL_PIN_TTL = 1200  # Manual entry of address/code/PIN may take longer
SAFE_ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'}
LOCK = STATE / '.lock'


class SetupError(Exception):
    pass


def require_root():
    if os.geteuid() != 0:
        raise SetupError('root required (via su or sudo; no SUDO_USER trust)')


def verified_dir(path, mode):
    try:
        st = path.lstat()
    except OSError as exc:
        raise SetupError('{}: {}'.format(path, exc))
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_gid != 0:
        raise SetupError('{}: root-owned real directory required'.format(path))
    if stat.S_IMODE(st.st_mode) != mode:
        raise SetupError('{}: required mode {:04o}'.format(path, mode))


def verified_file(path, uid, gid, mode):
    try:
        st = path.lstat()
    except OSError as exc:
        raise SetupError('{}: {}'.format(path, exc))
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
        raise SetupError('{}: must be ordinary single-link file'.format(path))
    if (st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode)) != (uid, gid, mode):
        raise SetupError('{}: owner/mode mismatch'.format(path))


def call_mutation(argv, input_text=None):
    # Explicit program names/argv, NEVER shell=True, and no secrets in argv.
    try:
        result = subprocess.run(argv, input=input_text, text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                check=False, timeout=20, env=SAFE_ENV)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise SetupError('system command {} failed: {}'.format(argv[0], exc))
    if result.returncode:
        # Do not print chpasswd stderr; never risk leaking a supplied PIN.
        if argv[0].endswith('/chpasswd'):
            raise SetupError('chpasswd failed; account requires operator inspection')
        raise SetupError('{} exit {}: {}'.format(argv[0], result.returncode,
                                                 result.stderr.strip()[:200]))


def timer_active():
    try:
        result = subprocess.run(['/usr/bin/systemctl', 'is-active', '--quiet',
                                 'aap2-cleanup.timer'], stdin=subprocess.DEVNULL,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                timeout=6, env=SAFE_ENV)
        return result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


@contextlib.contextmanager
def state_lock():
    require_root()
    verified_dir(STATE, 0o700)
    flags = os.O_CREAT | os.O_RDWR | getattr(os, 'O_NOFOLLOW', 0)
    fd = os.open(str(LOCK), flags, 0o600)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_uid != 0 or st.st_gid != 0 \
                or stat.S_IMODE(st.st_mode) != 0o600:
            raise SetupError('unsafe state lock: {}'.format(LOCK))
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def atomic_file(path, data, mode=0o600):
    """Write in a root-only directory, replace in one step. No fsync journal."""
    fd, temp = tempfile.mkstemp(prefix='.aap2-new-', dir=str(path.parent))
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, 'wb') as output:
            output.write(data)
        fd = -1
        os.replace(temp, str(path))
    finally:
        if fd != -1:
            os.close(fd)
        if os.path.exists(temp):
            os.unlink(temp)


def atomic_json(path, value, mode=0o600):
    data = (json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n').encode('utf-8')
    atomic_file(path, data, mode)


def identity_for(enrollment_id, role):
    return 'aap2e' + enrollment_id if role == GROUP_ENROLL else 'aap2p' + enrollment_id


def record_path(enrollment_id):
    if not ID_RE.fullmatch(enrollment_id):
        raise SetupError('invalid state ID')
    return STATE / enrollment_id


def read_metadata(enrollment_id):
    directory = record_path(enrollment_id)
    verified_dir(directory, 0o700)
    path = directory / 'metadata.json'
    verified_file(path, 0, 0, 0o600)
    with path.open('r', encoding='utf-8') as source:
        record = json.load(source)
    if record.get('id') != enrollment_id or record.get('state') not in (
            'creating', 'active', 'approved', 'expired', 'revoking', 'revoked'):
        raise SetupError('metadata ID/state mismatch for {}'.format(enrollment_id))
    users = record.get('users', {})
    for role in (GROUP_ENROLL, GROUP_PROXY):
        u = users.get(role, {})
        name = identity_for(enrollment_id, role)
        home = '/' if role == GROUP_ENROLL else '/nonexistent'
        if u.get('name') != name or u.get('home') != home:
            raise SetupError('metadata account name/home mismatch for {}'.format(enrollment_id))
        if not isinstance(u.get('uid'), int) or u['uid'] < MIN_UID:
            raise SetupError('metadata UID unsafe: {}'.format(enrollment_id))
        if not isinstance(u.get('gid'), int) or u['gid'] == 0:
            raise SetupError('metadata GID unsafe: {}'.format(enrollment_id))
        if not isinstance(u.get('verified'), bool):
            raise SetupError('metadata missing account validation state')
    if not isinstance(record.get('temp_removed', False), bool) or not isinstance(record.get('proxy_removed', False), bool):
        raise SetupError('metadata invalid account removal flags')
    if not isinstance(record.get('expires_at'), int):
        raise SetupError('metadata invalid expiry for {}'.format(enrollment_id))
    if not isinstance(record.get('remote_port'), int) or not (
            PORT_LOW <= record['remote_port'] <= PORT_HIGH):
        raise SetupError('invalid reserved remote port')
    return record


def all_records():
    verified_dir(STATE, 0o700)
    for path in sorted(STATE.iterdir()):
        if path.name == '.lock':
            continue
        if not ID_RE.fullmatch(path.name):
            raise SetupError('unexpected entry under state: {}'.format(path))
        yield read_metadata(path.name)


def unused_uid(reserved):
    candidate = MIN_UID
    while candidate <= 60000:
        if candidate not in reserved:
            try:
                pwd.getpwuid(candidate)
            except KeyError:
                return candidate
        candidate += 1
    raise SetupError('no available UID >= 1001')


def unused_port(reserved):
    for port in range(PORT_LOW, PORT_HIGH + 1):
        if port in reserved:
            continue
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
                sock.bind(('127.0.0.1', port))
            return port
        except OSError:
            continue
    raise SetupError('no unreserved/free loopback port')


def check_real_identity(record, role):
    """Must be called immediately before EVERY account modification."""
    account = record['users'][role]
    if not account['verified']:
        raise SetupError('{} UID was never verified; MANUAL repair required'.format(account['name']))
    if account['uid'] < MIN_UID:
        raise SetupError('protected UID {}'.format(account['uid']))
    try:
        user = pwd.getpwnam(account['name'])
        group = grp.getgrnam(role)
    except KeyError:
        raise SetupError('managed account/group missing: {}'.format(account['name']))
    expected = (account['uid'], account['gid'], account['home'])
    actual = (user.pw_uid, user.pw_gid, user.pw_dir)
    if actual != expected or group.gr_gid != account['gid'] or user.pw_shell not in SHELLS:
        raise SetupError('NSS identity changed for {}; REFUSING mutation'.format(account['name']))
    if set(os.getgrouplist(user.pw_name, user.pw_gid)) != {group.gr_gid}:
        raise SetupError('unexpected group memberships for {}'.format(account['name']))
    return user


def require_preflight():
    require_root()
    if sys.version_info < (3, 9):
        raise SetupError('requires Python 3.9+')
    for role in (GROUP_ENROLL, GROUP_PROXY):
        try:
            group = grp.getgrnam(role)
        except KeyError:
            raise SetupError('missing group {}'.format(role))
        if group.gr_gid == 0:
            raise SetupError('AAP2 group {} unexpectedly has GID 0'.format(role))
    for path, mode in ((BASE, 0o755), (STATE, 0o700), (ENROLL, 0o755),
                       (AUTHORIZED, 0o755)):
        verified_dir(path, mode)
    if not timer_active():
        raise SetupError('aap2-cleanup.timer is not active; NO PIN may be activated')
    checks = Checks()
    sshd = sshd_binary(checks)
    if sshd is None or command_output(checks, [sshd, '-t']) is None:
        raise SetupError('sshd -t failed (on-disk config); NO user created')
    return sshd


def verify_enrollment_policy(record, sshd, args):
    checks = Checks()
    for role in (GROUP_ENROLL, GROUP_PROXY):
        name = record['users'][role]['name']
        check_real_identity(record, role)
        actual = read_effective_config(checks, sshd, name, args.client_addr,
                                       args.client_host, args.server_addr,
                                       args.server_port)
        if actual is not None:
            check_policy(checks, actual, role)
    if checks.failed:
        raise SetupError('{} effective SSH policy errors; PIN NOT activated'.format(checks.failed))


def new_root_dir(path, mode):
    path.mkdir(mode=mode)
    os.chmod(str(path), mode)
    verified_dir(path, mode)


def new_file(path, data, mode, uid=0, gid=0):
    # CREATE EXCLUSIVE; no preexisting user-controlled names may be adopted.
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL |
                 getattr(os, 'O_NOFOLLOW', 0), mode)
    with os.fdopen(fd, 'wb') as output:
        os.fchmod(output.fileno(), mode)
        os.fchown(output.fileno(), uid, gid)
        output.write(data)
    verified_file(path, uid, gid, mode)


def make_chroot(record):
    name = record['users'][GROUP_ENROLL]['name']
    u = record['users'][GROUP_ENROLL]
    path = ENROLL / name
    new_root_dir(path, 0o755)
    new_root_dir(path / 'inbox', 0o755)
    config = {
        'schema': 1, 'username': record['users'][GROUP_PROXY]['name'],
        'remote_port': record['remote_port'],
    }
    status = {
        'schema': 1, 'status': 'pending', 'expires_at': record['expires_at'],
    }
    new_file(path / 'config.json',
             (json.dumps(config, separators=(',', ':')) + '\n').encode(), 0o644)
    new_file(path / 'status.json',
             (json.dumps(status, separators=(',', ':')) + '\n').encode(), 0o644)
    new_file(path / 'inbox' / 'public_key', b'', 0o600, u['uid'], u['gid'])


def generate_pin():
    # Exactly 10 decimal digits, including zero prefixes. Print as typed.
    return '{:010d}'.format(secrets.randbelow(10000000000))


def enroll(args):
    require_root()
    name = args.device_name
    if not (1 <= len(name) <= 64) or any(ord(c) < 32 or ord(c) > 126 for c in name):
        raise SetupError('device name must be 1-64 printable ASCII characters')
    if not re.fullmatch(r'[A-Za-z0-9.:\[\]-]{1,255}', args.server):
        raise SetupError('invalid server endpoint (use hostname/IP[:port])')
    # sshd -T -C needs a sample connection context for Match policy checks.
    # Client source IP is NOT an enrollment ACL and need not be known behind NAT.
    # When omitted, use a documentation-only external address for the probe.
    # Match Address/Host dependent installations require a separate review.
    if args.client_addr == '198.51.100.1':
        print('WARN: sshd Match policy tested with a sample client address; '
              'review any Match Address/Host rules separately.', file=sys.stderr)
    # Verify sshd -C context BEFORE any account creation; CLI does not
    # accept arbitrary SSH condition fragments such as comma-injected addr.
    try:
        ipaddress.ip_address(args.client_addr)
        ipaddress.ip_address(args.server_addr)
    except ValueError:
        raise SetupError('client/server SSH context addresses must be literal IPs')
    if not re.fullmatch(r'[A-Za-z0-9.-]{1,253}', args.client_host):
        raise SetupError('invalid SSH client hostname')
    try:
        if not (1 <= int(args.server_port) <= 65535):
            raise ValueError
    except ValueError:
        raise SetupError('invalid server-local SSH port')

    sshd = require_preflight()
    # Hold flock only during account/state setup; NOT while waiting for
    # administrator approval (S2). No PIN exists until the final step.
    with state_lock():
        existing = list(all_records())
        reserved_uid = set()
        reserved_ports = set()
        for previous in existing:
            if previous['state'] != 'revoked':
                reserved_ports.add(previous['remote_port'])
                for user in previous['users'].values():
                    reserved_uid.add(user['uid'])
        # Short numeric setup codes are public account selectors, not PINs.
        # Existing 12-hex enrolled identities remain valid forever.
        manual_code = getattr(args, 'manual_code', False)
        enrollment_id = ('{:06d}'.format(secrets.randbelow(1000000))
                         if manual_code else secrets.token_hex(6))
        while (STATE / enrollment_id).exists():
            enrollment_id = ('{:06d}'.format(secrets.randbelow(1000000))
                             if manual_code else secrets.token_hex(6))
        usernames = {role: identity_for(enrollment_id, role)
                     for role in (GROUP_ENROLL, GROUP_PROXY)}
        for username in usernames.values():
            try:
                pwd.getpwnam(username)
            except KeyError:
                continue
            raise SetupError('generated username already exists: {}'.format(username))

        g_enroll = grp.getgrnam(GROUP_ENROLL).gr_gid
        g_proxy = grp.getgrnam(GROUP_PROXY).gr_gid
        euid = unused_uid(reserved_uid)
        puid = unused_uid(reserved_uid | {euid})
        port = unused_port(reserved_ports)
        ttl = MANUAL_PIN_TTL if manual_code else PIN_TTL
        expiry = int(time.time()) + ttl
        record = {
            'schema': 1, 'id': enrollment_id, 'device_name': name,
            'state': 'creating', 'created_at': int(time.time()),
            'expires_at': expiry, 'remote_port': port,
            'temp_removed': False, 'proxy_removed': False,
            'users': {
                GROUP_ENROLL: {'name': usernames[GROUP_ENROLL], 'uid': euid,
                               'gid': g_enroll, 'home': '/', 'verified': False},
                GROUP_PROXY: {'name': usernames[GROUP_PROXY], 'uid': puid,
                              'gid': g_proxy, 'home': '/nonexistent', 'verified': False},
            },
        }
        state_dir = record_path(enrollment_id)
        new_root_dir(state_dir, 0o700)
        atomic_json(state_dir / 'metadata.json', record)
        for role in (GROUP_ENROLL, GROUP_PROXY):
            account = record['users'][role]
            password_marker = '!' if role == GROUP_ENROLL else 'NP'
            argv = ['/usr/sbin/useradd', '-M', '-u', str(account['uid']),
                    '-g', role, '-d', account['home'], '-s',
                    '/usr/sbin/nologin', '-p', password_marker, account['name']]
            call_mutation(argv)
            # Independent NSS confirmation, stored before next useradd.
            user = pwd.getpwnam(account['name'])
            if (user.pw_uid, user.pw_gid, user.pw_dir, user.pw_shell) != (
                    account['uid'], account['gid'], account['home'],
                    '/usr/sbin/nologin'):
                raise SetupError('new user identity mismatch; MANUAL repair required')
            if set(os.getgrouplist(account['name'], account['gid'])) != {account['gid']}:
                raise SetupError('new user has unexpected groups; MANUAL repair required')
            account['verified'] = True
            atomic_json(state_dir / 'metadata.json', record)

        make_chroot(record)
        proxy = record['users'][GROUP_PROXY]
        new_file(AUTHORIZED / proxy['name'], b'', 0o644)
        verify_enrollment_policy(record, sshd, args)

        # Must remain active immediately before exposing a bearer PIN.
        if not timer_active() or int(time.time()) >= expiry:
            raise SetupError('cleanup timer stopped or invitation already expired; NO PIN activated')
        record['state'] = 'active'
        atomic_json(state_dir / 'metadata.json', record)
        pin = generate_pin()
        check_real_identity(record, GROUP_ENROLL)
        call_mutation(['/usr/sbin/chpasswd'],
                      input_text='{}:{}\n'.format(usernames[GROUP_ENROLL], pin))

    print('Enrollment created. The PIN is valid for up to {} minutes.'.format(
        (MANUAL_PIN_TTL if manual_code else PIN_TTL) // 60))
    print('Server: {}'.format(args.server))
    print('Setup username: {}'.format(usernames[GROUP_ENROLL]))
    if manual_code:
        print('Phone setup code (6 digits, no prefix): {}'.format(enrollment_id))
    print('One-time PIN (type all 10 digits): {}'.format(pin))
    print('Enrollment ID: {}'.format(enrollment_id))
    for path in sorted(Path('/etc/ssh').glob('ssh_host_*_key.pub')):
        if path.is_file() and not path.is_symlink():
            output = command_output(Checks(),
                                    ['/usr/bin/ssh-keygen', '-lf', str(path), '-E', 'sha256'])
            if output:
                print('Host key fingerprint (match ALGORITHM on phone): {}'.format(output.strip()))
    print('Upload public key through PIN-only SFTP, then run: aap2-setup approve {}'.format(enrollment_id))
    return 0


def remove_chroot(record):
    """Unlink ONLY exact previously-created files. No recursive userdel -r."""
    username = record['users'][GROUP_ENROLL]['name']
    user = record['users'][GROUP_ENROLL]
    root = ENROLL / username
    verified_dir(root, 0o755)
    verified_dir(root / 'inbox', 0o755)
    for path, uid, gid, mode in (
            (root / 'inbox' / 'public_key', user['uid'], user['gid'], 0o600),
            (root / 'config.json', 0, 0, 0o644),
            (root / 'status.json', 0, 0, 0o644)):
        verified_file(path, uid, gid, mode)
    (root / 'inbox' / 'public_key').unlink()
    (root / 'inbox').rmdir()
    (root / 'config.json').unlink()
    (root / 'status.json').unlink()
    root.rmdir()


def stop_user(uid):
    """Terminate only the metadata-verified AAP2 user's processes."""
    try:
        result = subprocess.run(['/usr/bin/pkill', '-TERM', '-u', str(uid)],
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, timeout=8, env=SAFE_ENV)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise SetupError('failed to stop AAP2 user sessions: {}'.format(exc))
    if result.returncode not in (0, 1):
        raise SetupError('pkill returned unexpected status {}'.format(result.returncode))


def remove_account(record, role):
    """Never force userdel. Revalidate NSS/UID/GID/group/home on every retry."""
    name = record['users'][role]['name']
    # Verify again immediately before signalling processes; a previously
    # checked UID must never be reused to signal an unrelated account.
    check_real_identity(record, role)
    stop_user(record['users'][role]['uid'])
    for attempt in range(4):
        check_real_identity(record, role)
        try:
            call_mutation(['/usr/sbin/userdel', name])
            return
        except SetupError as exc:
            if 'userdel exit 8:' not in str(exc) or attempt == 3:
                raise
            time.sleep(1)


def remove_temporary(record):
    if record.get('temp_removed', False):
        return
    name = record['users'][GROUP_ENROLL]['name']
    check_real_identity(record, GROUP_ENROLL)
    call_mutation(['/usr/sbin/usermod', '-L', name])
    check_real_identity(record, GROUP_ENROLL)
    remove_account(record, GROUP_ENROLL)
    remove_chroot(record)
    record['temp_removed'] = True
    if record['state'] not in ('approved', 'revoking', 'revoked'):
        record['state'] = 'expired'
    atomic_json(record_path(record['id']) / 'metadata.json', record)


def cleanup(_args):
    require_root()
    errors = 0
    with state_lock():
        verified_dir(STATE, 0o700)
        for path in sorted(STATE.iterdir()):
            if path.name == '.lock':
                continue
            try:
                record = read_metadata(path.name)
            except (SetupError, OSError, ValueError, json.JSONDecodeError) as exc:
                errors += 1
                print('FAIL CLOSED: invalid state {}: {}'.format(path.name, exc),
                      file=sys.stderr)
                continue
            if record.get('temp_removed') or record['expires_at'] > int(time.time()):
                continue
            try:
                remove_temporary(record)
                print('Expired temporary enrollment: {}'.format(record['id']))
            except (SetupError, OSError, ValueError) as exc:
                errors += 1
                print('FAIL CLOSED: {}: {}'.format(record['id'], exc), file=sys.stderr)
    return 1 if errors else 0



def ssh_field(data, index):
    """Parse only SSH wire framing; OpenSSH validates the actual public key."""
    if index + 4 > len(data):
        raise SetupError('truncated SSH public-key blob')
    length = struct.unpack('>I', data[index:index + 4])[0]
    index += 4
    if length > 1024 or index + length > len(data):
        raise SetupError('invalid SSH key field length')
    return data[index:index + length], index + length


def canonical_public_key(raw):
    """Exactly one ECDSA P-256 public key; NEVER accept authorized_keys options."""
    if not raw or len(raw) > 1024 or not raw.endswith(b'\n') or b'\r' in raw:
        raise SetupError('upload must be exactly one <=1KiB SSH public key line')
    if raw.count(b'\n') != 1 or b'\t' in raw or b'  ' in raw:
        raise SetupError('upload contains extra lines or unsafe whitespace')
    try:
        pieces = raw[:-1].decode('ascii').split(' ')
    except UnicodeDecodeError:
        raise SetupError('upload is not ASCII SSH public key')
    if len(pieces) not in (2, 3) or pieces[0] != 'ecdsa-sha2-nistp256':
        raise SetupError('only an ECDSA P-256 public-key line is supported')
    if len(pieces) == 3 and not re.fullmatch(r'[A-Za-z0-9._@:-]{1,64}', pieces[2]):
        raise SetupError('unsupported SSH public key comment')
    encoded = pieces[1]
    if not re.fullmatch(r'[A-Za-z0-9+/]+={0,2}', encoded):
        raise SetupError('invalid base64 characters in SSH key')
    try:
        blob = base64.b64decode(encoded, validate=True)
    except (ValueError, base64.binascii.Error):
        raise SetupError('invalid SSH key base64')
    if base64.b64encode(blob).decode('ascii') != encoded:
        raise SetupError('noncanonical SSH public key encoding')
    algorithm, i = ssh_field(blob, 0)
    curve, i = ssh_field(blob, i)
    point, i = ssh_field(blob, i)
    if (algorithm != b'ecdsa-sha2-nistp256' or curve != b'nistp256'
            or len(point) != 65 or point[0] != 4 or i != len(blob)):
        raise SetupError('invalid ECDSA P-256 SSH public key structure')
    return 'ecdsa-sha2-nistp256 ' + encoded + '\n'


def read_uploaded_public_key(record):
    """Open the precreated SFTP file without symlink following; bounded read."""
    name = record['users'][GROUP_ENROLL]['name']
    account = record['users'][GROUP_ENROLL]
    root = ENROLL / name
    verified_dir(root, 0o755)
    verified_dir(root / 'inbox', 0o755)
    path = root / 'inbox' / 'public_key'
    fd = os.open(str(path), os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) |
                 getattr(os, 'O_NONBLOCK', 0))
    try:
        st = os.fstat(fd)
        if (not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or
                st.st_uid != account['uid'] or st.st_gid != account['gid'] or
                stat.S_IMODE(st.st_mode) != 0o600 or st.st_size > 1024):
            raise SetupError('SFTP inbox public_key has unsafe ownership/type/size')
        raw = os.read(fd, 1025)
        after = os.fstat(fd)
        if (st.st_ino != after.st_ino or st.st_size != after.st_size or
                st.st_mtime_ns != after.st_mtime_ns or len(raw) != st.st_size):
            raise SetupError('SFTP upload changed during snapshot; retry')
    finally:
        os.close(fd)
    return canonical_public_key(raw)


def fingerprint_public_key(path):
    """OpenSSH is the source of truth on acceptable ECDSA public keys."""
    output = command_output(Checks(),
        ['/usr/bin/ssh-keygen', '-lf', str(path), '-E', 'sha256'])
    if output is None or not output.strip().startswith('256 SHA256:'):
        raise SetupError('OpenSSH rejected candidate key; upload can be corrected')
    return output.strip()


def snapshot_key(record):
    """Persist the first *OpenSSH-validated* key, never an invalid upload."""
    directory = record_path(record['id'])
    candidate = directory / 'candidate.pub'
    if candidate.exists() or candidate.is_symlink():
        verified_file(candidate, 0, 0, 0o600)
        data = candidate.read_bytes()
        canonical = canonical_public_key(data)
        if canonical.encode('ascii') != data:
            raise SetupError('existing candidate snapshot has noncanonical content')
        return canonical, fingerprint_public_key(candidate)

    canonical = read_uploaded_public_key(record)
    # Validation must happen BEFORE creating immutable candidate.pub.
    # A malicious/incomplete first upload must not poison an invitation.
    fd, temp = tempfile.mkstemp(prefix='.aap2-candidate-', dir=str(directory))
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'wb') as output:
            output.write(canonical.encode('ascii'))
        fd = -1
        fingerprint = fingerprint_public_key(Path(temp))
        os.replace(temp, str(candidate))
        verified_file(candidate, 0, 0, 0o600)
    finally:
        if fd != -1:
            os.close(fd)
        if os.path.exists(temp):
            os.unlink(temp)
    return canonical, fingerprint


def authorized_line(record, key_line):
    # Quoted explicit 127.0.0.1 listener; cannot request wildcard or localhost.
    return ('restrict,port-forwarding,permitlisten="127.0.0.1:{}" {}'
            .format(record['remote_port'], key_line))


def approve(args):
    """Snapshot under lock; read admin answer OUTSIDE lock; recheck then install."""
    require_root()
    with state_lock():
        record = read_metadata(args.enrollment_id)
        if record['state'] == 'approved':
            print('Already approved: {}'.format(args.enrollment_id))
            return 0
        if record['state'] != 'active' or record.get('temp_removed'):
            raise SetupError('invitation is not active; cannot approve')
        if int(time.time()) >= record['expires_at']:
            raise SetupError('invitation expired before approval')
        if not timer_active():
            raise SetupError('cleanup timer not active; cannot approve')
        check_real_identity(record, GROUP_ENROLL)
        check_real_identity(record, GROUP_PROXY)
        # Snapshot once, in root-only state. Subsequent upload has no effect.
        key_line, fingerprint = snapshot_key(record)

    print('Device: {}'.format(record['device_name']))
    print('Client key fingerprint: {}'.format(fingerprint))
    print('Permanent username: {}'.format(record['users'][GROUP_PROXY]['name']))
    print('Allowed listener: 127.0.0.1:{}'.format(record['remote_port']))
    try:
        answer = input('Approve this exact key? [y/N]: ').strip()
    except EOFError:
        answer = ''
    if answer != 'y':
        print('Cancelled; candidate snapshot unchanged, no key authorized')
        return 1

    with state_lock():
        record = read_metadata(args.enrollment_id)
        if record['state'] not in ('active', 'approved'):
            raise SetupError('state changed while waiting; NOT approved')
        if record['state'] == 'active' and (
                int(time.time()) >= record['expires_at'] or
                record.get('temp_removed') or not timer_active()):
            raise SetupError('invitation expired or disabled during approval')
        check_real_identity(record, GROUP_PROXY)
        if not record.get('temp_removed'):
            check_real_identity(record, GROUP_ENROLL)

        # Check exact source snapshot matches what administrator approved.
        candidate = record_path(record['id']) / 'candidate.pub'
        verified_file(candidate, 0, 0, 0o600)
        if candidate.read_bytes() != key_line.encode('ascii'):
            raise SetupError('candidate changed after confirmation; refusing')
        # Refuse port collisions with any other non-revoked device.
        for other in all_records():
            if other['id'] != record['id'] and other['state'] != 'revoked' \
                    and other['remote_port'] == record['remote_port']:
                raise SetupError('reserved listener collides with another enrollment')
        verified_dir(AUTHORIZED, 0o755)
        auth_path = AUTHORIZED / record['users'][GROUP_PROXY]['name']
        verified_file(auth_path, 0, 0, 0o644)
        desired = authorized_line(record, key_line).encode('ascii')
        present = auth_path.read_bytes()
        if present not in (b'', desired):
            raise SetupError('unexpected authorized_keys content; refusing overwrite')
        if present != desired:
            atomic_file(auth_path, desired, 0o644)
        # Publish status only AFTER authorized_keys is in place.
        status_path = ENROLL / record['users'][GROUP_ENROLL]['name'] / 'status.json'
        if not record.get('temp_removed'):
            verified_file(status_path, 0, 0, 0o644)
            atomic_json(status_path, {
                'schema': 1, 'status': 'approved',
                'expires_at': record['expires_at']
            }, 0o644)
        record['state'] = 'approved'
        atomic_json(record_path(record['id']) / 'metadata.json', record)
    print('APPROVED: {}  127.0.0.1:{}'.format(
        record['users'][GROUP_PROXY]['name'], record['remote_port']))
    return 0


def revoke(args):
    """Explicit device revocation; never inferred from username/prefix."""
    require_root()
    with state_lock():
        record = read_metadata(args.enrollment_id)
        if record['state'] == 'revoked':
            print('Already revoked: {}'.format(args.enrollment_id))
            return 0
        if record['state'] == 'creating':
            raise SetupError('incomplete creating record; MANUAL repair required')
        print('Revoke device {}, ID {}, user {}, port 127.0.0.1:{}?'.format(
            record['device_name'], record['id'],
            record['users'][GROUP_PROXY]['name'], record['remote_port']))
    try:
        answer = input('Type REVOKE to remove this device access: ').strip()
    except EOFError:
        answer = ''
    if answer != 'REVOKE':
        print('Cancelled; no access changed')
        return 1

    with state_lock():
        record = read_metadata(args.enrollment_id)
        if record['state'] == 'revoked':
            return 0
        if record['state'] not in ('active', 'expired', 'approved', 'revoking'):
            raise SetupError('not a revocable enrollment state')
        if not record.get('proxy_removed'):
            check_real_identity(record, GROUP_PROXY)
        if not record.get('temp_removed'):
            check_real_identity(record, GROUP_ENROLL)
        verified_dir(AUTHORIZED, 0o755)
        auth_path = AUTHORIZED / record['users'][GROUP_PROXY]['name']
        verified_file(auth_path, 0, 0, 0o644)
        current = auth_path.read_bytes()
        if record['state'] in ('approved', 'revoking') and current:
            candidate = record_path(record['id']) / 'candidate.pub'
            verified_file(candidate, 0, 0, 0o600)
            canonical = canonical_public_key(candidate.read_bytes())
            if current != authorized_line(record, canonical).encode('ascii'):
                raise SetupError('authorized key changed; refusing to modify')
        elif record['state'] in ('active', 'expired') and current:
            raise SetupError('unexpected authorized key for unapproved device')
        # First disable any NEW publickey logins.
        record['state'] = 'revoking'
        atomic_json(record_path(record['id']) / 'metadata.json', record)
        if current:
            atomic_file(auth_path, b'', 0o644)
        # Remove ALREADY CONNECTED sessions; then delete only this account.
        if not record.get('proxy_removed'):
            remove_account(record, GROUP_PROXY)
            record['proxy_removed'] = True
            atomic_json(record_path(record['id']) / 'metadata.json', record)
        if not record.get('temp_removed'):
            remove_temporary(record)
        verified_file(auth_path, 0, 0, 0o644)
        if auth_path.read_bytes():
            raise SetupError('key file unexpectedly repopulated during revoke')
        auth_path.unlink()
        record['state'] = 'revoked'
        atomic_json(record_path(record['id']) / 'metadata.json', record)
    print('REVOKED: {} (permanent key, account and temp PIN access)'.format(args.enrollment_id))
    return 0



def list_enrollments(_args):
    require_root()
    with state_lock():
        for record in all_records():
            print('{}  {}  {}  port={}  expires={}'.format(
                record['id'], record['state'], record['device_name'],
                record['remote_port'],
                datetime.datetime.fromtimestamp(record['expires_at'],
                                                datetime.timezone.utc).isoformat()))
    return 0


def main():
    parser = argparse.ArgumentParser(prog='aap2-setup',
        description='AAP2 OpenSSH server CLI: PIN, SFTP key approval and per-device revoke')
    sub = parser.add_subparsers(dest='action', required=True)
    pc = sub.add_parser('print-config', help='print manual-only SSH Match template')
    pc.set_defaults(func=print_config)
    doc = sub.add_parser('doctor', help='read-only preflight and effective OpenSSH checks')
    doc.add_argument('--enroll-user', help='existing AAP2 temporary test account')
    doc.add_argument('--proxy-user', help='existing AAP2 permanent test account')
    doc.add_argument('--client-addr', default='127.0.0.1', help='SSH client source IP (not server)')
    doc.add_argument('--client-host', default='localhost', help='SSH client hostname (not server)')
    doc.add_argument('--server-addr', default='127.0.0.1', help='sshd local address')
    doc.add_argument('--server-port', default='22', help='sshd *guest-local* port')
    doc.set_defaults(func=doctor)
    en = sub.add_parser('enroll', help='create temporary PIN/SFTP invitation (NO approval yet)')
    en.add_argument('device_name', help='admin-facing device label')
    en.add_argument('--server', required=True, help='SSH host[:port] shown to user')
    en.add_argument('--client-addr', default='198.51.100.1',
                    help='optional SSH Match policy probe source IP; defaults to TEST-NET-2 example, NOT a required phone address')
    en.add_argument('--client-host', default='unknown', help='client hostname for sshd -T')
    en.add_argument('--server-addr', required=True, help='real sshd listen IP')
    en.add_argument('--server-port', default='22', help='sshd LOCAL port')
    en.add_argument('--manual-code', action='store_true',
                    help='issue a six-digit numeric setup code for manual Android entry')
    en.set_defaults(func=enroll)
    ap = sub.add_parser('approve', help='snapshot uploaded key and manually approve')
    ap.add_argument('enrollment_id', help='S2 enrollment ID (six digits or legacy hex)')
    ap.set_defaults(func=approve)
    rv = sub.add_parser('revoke', help='explicitly revoke ONE registered device')
    rv.add_argument('enrollment_id', help='S2 enrollment ID (six digits or legacy hex)')
    rv.set_defaults(func=revoke)
    cl = sub.add_parser('cleanup', help='expire temporary PIN/SFTP users')
    cl.set_defaults(func=cleanup)
    li = sub.add_parser('list', help='list root-owned invitation metadata')
    li.set_defaults(func=list_enrollments)
    args = parser.parse_args()
    return args.func(args)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (SetupError, OSError, ValueError, json.JSONDecodeError) as exc:
        print('AAP2 ERROR: {}'.format(exc), file=sys.stderr)
        sys.exit(1)
