<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy devices use allowBackup=false; this file also explicitly excludes
     data in case an OEM attempts a backup despite the manifest switch. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
